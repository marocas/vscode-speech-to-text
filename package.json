{
  "name": "smart-transcription-daemon",
  "version": "0.1.0",
  "description": "Smart voice-to-text transcription daemon for developers",
  "main": "dist/main/main.js",
  "homepage": "./",
  "private": true,
  "author": "Your Team",
  "license": "MIT",
  "volta": {
    "node": "22.16.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "concurrently \"yarn build:main:watch\" \"yarn dev:renderer\" \"wait-on file:dist/.dev-server-url && electron dist/main/main.js\" --names \"WATCH,VITE,ELECTRON\" --prefix-colors blue,green,cyan",
    "dev:renderer": "vite",
    "build": "yarn build:renderer && yarn build:main",
    "build:watch": "concurrently \"yarn build:renderer:watch\" \"yarn build:main:watch\"",
    "build:renderer": "vite build",
    "build:renderer:watch": "vite build --watch",
    "build:main": "tsc -p tsconfig.main.json && yarn copy-prisma-engines",
    "build:main:watch": "tsc -p tsconfig.main.json --watch",
    "copy-prisma-engines": "cp src/main/generated/prisma/*.node dist/main/generated/prisma/ 2>/dev/null; cp src/main/generated/prisma/schema.prisma dist/main/generated/prisma/ 2>/dev/null; true",
    "start": "electron dist/main/main.js",
    "pack": "electron-builder --dir",
    "build:agent": "cd native-agent && swift build -c release && codesign --force --options runtime --entitlements STDAgent.entitlements --sign - .build/release/STDAgent",
    "dist": "yarn build && yarn build:agent && electron-builder --mac",
    "dist:mac": "yarn build && yarn build:agent && electron-builder --mac",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "postinstall": "prisma generate && electron-builder install-app-deps"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.14.0",
    "@prisma/client": "^6.19.2",
    "dotenv": "^16.4.5",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.2.10",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.1.0",
    "concurrently": "^8.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.49.0",
    "prisma": "^6.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "icon": "public/image/icon.icns",
    "appId": "com.smart-transcription-daemon.app",
    "productName": "Smart Transcription Daemon",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "dist/main/generated/prisma/*.node",
      "dist/main/generated/prisma/schema.prisma",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/engines/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "public/image/trayTemplate.png",
        "to": "image/trayTemplate.png"
      },
      {
        "from": "native-agent/.build/release/STDAgent",
        "to": "bin/STDAgent"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Smart Transcription Daemon needs microphone access to capture and transcribe your speech.",
        "NSAppleEventsUsageDescription": "Smart Transcription Daemon needs to control other applications to insert transcribed text."
      }
    }
  }
}
